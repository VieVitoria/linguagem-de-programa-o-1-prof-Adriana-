<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="800.0" style="-fx-background-color: #DBCFBE;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.menu.multiplo">

    <children>
        <VBox alignment="CENTER" layoutX="33.0" layoutY="48.0" prefHeight="613.0" prefWidth="741.0" spacing="15.0" style="-fx-background-color: #4d290b; -fx-background-radius: 10; -fx-padding: 35;">

            <children>
                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 23px;" text="VERIFICAÇÃO DE MÚLTIPLOS" />

                <Label style="-fx-text-fill: #ffffff;" text="Digite o primeiro número:" />

                <TextField fx:id="txtNum1" prefHeight="25.0" prefWidth="450.0" promptText="Primeiro número" />

                <Label style="-fx-text-fill: #ffffff;" text="Digite o segundo número:" />

                <TextField fx:id="txtNum2" promptText="Segundo número" />

                <Button onAction="#verificarMultiplos" style="-fx-background-color: #DBCFBE; -fx-text-fill: #4d290b;" text="VERIFICAR" />

                <Label fx:id="lblResultado" maxWidth="500.0" style="-fx-text-fill: #ffffff; -fx-font-size: 15px;" wrapText="true" />

                <Button onAction="#voltar" style="-fx-background-color: #DBCFBE; -fx-text-fill: #4d290b;" text="VOLTAR" />
            </children>
        </VBox>
    </children>

</AnchorPane>
