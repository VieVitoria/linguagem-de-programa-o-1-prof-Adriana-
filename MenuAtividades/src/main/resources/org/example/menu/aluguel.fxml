<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700" prefWidth="800" style="-fx-background-color: #DBCFBE;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.menu.aluguel">

        <VBox alignment="CENTER" layoutX="30.0" layoutY="44.0" prefHeight="613.0" prefWidth="741.0" spacing="18" style="-fx-background-color: #4d290b; -fx-background-radius: 10; -fx-padding: 40;">

                <Label style="-fx-text-fill: white; -fx-font-size: 25px;" text="ALUGUEL DE CARRO" />

                <Label style="-fx-text-fill: white;" text="Quantidade de dias:" />
                <TextField fx:id="txtDias" maxWidth="300" promptText="Ex.: 5" />

                <Label style="-fx-text-fill: white;" text="Quilometragem percorrida:" />
                <TextField fx:id="txtKm" maxWidth="300" promptText="Ex.: 600" />

                <Button onAction="#calcularAluguel" style="-fx-background-color: #DBCFBE; -fx-text-fill: #4d290b;" text="CALCULAR ALUGUEL" />

                <Label fx:id="lblResultado" style="-fx-text-fill: white;" wrapText="true" />

                <Button onAction="#voltar" style="-fx-background-color: #DBCFBE; -fx-text-fill: #4d290b;" text="VOLTAR" />
        </VBox>
</AnchorPane>
